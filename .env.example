# Copy to .env (`make up` does this for you if .env is missing). Local development values only.
# Docker Compose reads this file; the Makefile reads it for host ports and test URLs.
# Keep values plain (no quotes, no inline comments): the Makefile includes this file too.

# Claude API key: `make chat` and `make smoke` need it (tests and `make test` don't).
ANTHROPIC_API_KEY=

# Postgres credentials for the local stack.
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay-dev-only
POSTGRES_DB=relay

# Host ports. All of them bind to 127.0.0.1 only.
# The app through Caddy: http://localhost:8080
RELAY_HTTP_PORT=8080
# Phoenix trace UI: http://localhost:6006
PHOENIX_HOST_PORT=6006
# Postgres and Redis, for tests and for psql or redis-cli from the host.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# App settings use the RELAY_ prefix. See backend/src/relay/config.py.
RELAY_ENV=dev
RELAY_LOG_LEVEL=INFO

# Signs the per-turn tokens that tell the MCP server which customer the agent acts for (HS256,
# 32+ characters). A development value: with RELAY_ENV=prod, anything containing "dev-only" is
# refused. Make a real one with: openssl rand -hex 32
RELAY_MCP_JWT_SECRET=dev-only-mcp-turn-token-secret-change-me

# The agent (PLAN.md §5.6). RELAY_PROVIDER is anthropic or openai; the model is pinned on each
# conversation when it starts. Effort: low, medium, high, xhigh or max.
RELAY_PROVIDER=anthropic
RELAY_AGENT_MODEL=claude-opus-5-5
RELAY_AGENT_EFFORT=medium
# error: a replayed history that no longer matches a thinking block fails the request (dev, CI,
# evals). Production sets drop_block and alerts instead.
RELAY_THINKING_PREFIX_MISMATCH=error
# Only for RELAY_PROVIDER=openai (contract-tested against a fake API, not run live here).
OPENAI_API_KEY=
RELAY_OPENAI_MODEL=gpt-5.5

# The simulated customer in the evals (PLAN.md §9.1). `make eval` runs on the host and reads
# ANTHROPIC_API_KEY above.
RELAY_SIM_MODEL=claude-opus-5-5
RELAY_SIM_EFFORT=low
