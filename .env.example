# Copy to .env (`make up` does this for you if .env is missing). Local development values only.
# Docker Compose reads this file; the Makefile reads it for host ports and test URLs.
# Keep values plain (no quotes, no inline comments): the Makefile includes this file too.

# Claude API key: `make chat` and `make smoke` need it (tests and `make test` don't).
ANTHROPIC_API_KEY=

# Postgres credentials for the local stack.
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay-dev-only
POSTGRES_DB=relay
# The API and the MCP server connect as this role, which `relay db upgrade` creates: data access
# only, no DDL, an append-only audit log (PLAN.md §11). 16+ characters; set your own in production.
RELAY_APP_DB_ROLE=relay_app
RELAY_APP_DB_PASSWORD=dev-only-app-db-password

# Host ports. All of them bind to 127.0.0.1 only.
# The app through Caddy: http://localhost:8080
RELAY_HTTP_PORT=8080
# Phoenix trace UI: http://localhost:6006
PHOENIX_HOST_PORT=6006
# Postgres and Redis, for tests and for psql or redis-cli from the host.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# App settings use the RELAY_ prefix. See backend/src/relay/config.py.
RELAY_ENV=dev
RELAY_LOG_LEVEL=INFO

# Signs the per-turn tokens that tell the MCP server which customer the agent acts for (HS256,
# 32+ characters). A development value: with RELAY_ENV=prod, anything containing "dev-only" is
# refused. Make a real one with: openssl rand -hex 32
RELAY_MCP_JWT_SECRET=dev-only-mcp-turn-token-secret-change-me

# The agent (PLAN.md §5.6). RELAY_PROVIDER is anthropic, openai, or scripted: a rule-based demo
# agent that needs no key and calls no model (it tells the refund story; `make e2e` uses it).
# The model is pinned on each conversation when it starts. Effort: low, medium, high, xhigh, max.
RELAY_PROVIDER=anthropic
RELAY_AGENT_MODEL=claude-opus-5-5
RELAY_AGENT_EFFORT=medium
# error: a replayed history that no longer matches a thinking block fails the request (dev, CI,
# evals). Production sets drop_block and alerts instead.
RELAY_THINKING_PREFIX_MISMATCH=error
# Only for RELAY_PROVIDER=openai (contract-tested against a fake API, not run live here).
OPENAI_API_KEY=
RELAY_OPENAI_MODEL=gpt-5.5

# The simulated customer in the evals (PLAN.md §9.1). `make eval` runs on the host and reads
# ANTHROPIC_API_KEY above.
RELAY_SIM_MODEL=claude-opus-5-5
RELAY_SIM_EFFORT=low
# The judge that scores each eval trial against the rubric (PLAN.md §9.6).
RELAY_JUDGE_MODEL=claude-sonnet-5-5
RELAY_JUDGE_EFFORT=medium

# The API (PLAN.md §11, §12). Keys session IDs before they go into Redis (32+ characters;
# "dev-only" values are refused when RELAY_ENV=prod). Make one with: openssl rand -hex 32
RELAY_SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# The local stack serves plain http://localhost:8080, so session cookies can't be Secure here.
RELAY_COOKIE_SECURE=false
# Demo mode: the persona picker gives each browser private copies of the demo customers, and a
# demo operator login shows only that browser's conversations. Off: the persona login signs in
# as the seeded persona, and only the password operator can open the console.
RELAY_DEMO_MODE=true
# The password operator. Make the hash with `cd backend && uv run relay operator hash-password`
# and paste it inside single quotes (it contains $ signs that Compose would otherwise expand):
# RELAY_OPERATOR_PASSWORD_HASH='$argon2id$v=19$...'
RELAY_OPERATOR_EMAIL=operator@relay.example
RELAY_OPERATOR_PASSWORD_HASH=
# The hard daily spend cap in US dollars: no model call starts if its worst-case cost would pass it.
RELAY_DAILY_SPEND_CAP_USD=20

# Tracing (PLAN.md §10): redacted message previews on spans (the default), none, or full
# (local debugging only; refused when RELAY_ENV=prod). Compose sends spans to Phoenix.
RELAY_TRACE_CONTENT=redacted
# Where the operator console links to traces: Phoenix as your browser reaches it.
RELAY_PHOENIX_URL=http://localhost:6006

# "Create eval scenario" in the console drafts a scenario with this model (needs ANTHROPIC_API_KEY).
RELAY_DRAFTER_MODEL=claude-opus-5-5
