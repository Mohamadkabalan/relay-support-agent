# The production .env, kept on the server in /opt/relay/.env (mode 600), never in git.
# compose.prod.yaml refuses to start while a required value is missing. docs/DEPLOY.md explains
# each step; generate secrets with: openssl rand -hex 32

# Where the app lives and who Let's Encrypt writes to.
RELAY_DOMAIN=relay.example.com
ACME_EMAIL=you@example.com

# The images: ghcr.io/<your GitHub user or org, lowercase>, and the release tag without the "v".
# deploy/deploy.sh rewrites RELAY_VERSION on every deploy.
RELAY_IMAGE_PREFIX=ghcr.io/your-github-user
RELAY_VERSION=1.0.0

# Model access. Use a dedicated Claude Console workspace with its own spend limit for the demo,
# as a backstop to the app's own daily cap below.
ANTHROPIC_API_KEY=

# Secrets (each 32+ random characters; none may contain "dev-only").
POSTGRES_PASSWORD=
RELAY_APP_DB_PASSWORD=
RELAY_MCP_JWT_SECRET=
RELAY_SESSION_SECRET=

# The demo: persona picker, per-visitor copies, the demo operator login, the nightly reset.
RELAY_DEMO_MODE=true
RELAY_DAILY_SPEND_CAP_USD=20
# A real operator login besides the demo one (optional): relay operator hash-password.
# Single-quote the hash: it contains "$".
RELAY_OPERATOR_EMAIL=operator@relay.example
RELAY_OPERATOR_PASSWORD_HASH=
